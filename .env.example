NODE_ENV=development
PORT=3000

# DB (local: localhost + compose; en compose la API usa host "db")
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hotel_db

# Redis opcional: si se define, el rate-limit usa Redis; si no, memoria
REDIS_URL=redis://localhost:6379

# CORS: orígenes permitidos separados por coma (nunca '*' en prod)
CORS_ORIGIN=http://localhost:4200

# Rate limit: ventana en ms + máx peticiones por IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# JWT (Sprint 2). En producción son obligatorios.
JWT_ACCESS_SECRET=cambia-este-secreto-access
JWT_REFRESH_SECRET=cambia-este-secreto-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Admin sembrado con npm run seed (Sprint 2)
ADMIN_EMAIL=admin@hotel.local
ADMIN_PASSWORD=Admin123!

# Bcrypt cost (menor en local/test para velocidad)
BCRYPT_ROUNDS=10
